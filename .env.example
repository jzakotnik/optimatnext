# Every *_CACHE_SECONDS var controls how often the background scheduler
# refreshes that source. If omitted, a sane default is used (see lib/sources/index.ts)
# — missing values never cause extra live requests, they just fall back.

# --- Traffic (Google Distance Matrix) ---
GOOGLETRAFFIC_URL=https://maps.googleapis.com/maps/api/distancematrix/json
GOOGLE_API_KEY=your Google API key
GOOGLETRAFFIC_SOURCE=source location
GOOGLETRAFFIC_DESTINATION=destination location
TRAFFIC_CACHE_SECONDS=300

# --- Weather (OpenWeatherMap) ---
OPENWEATHER_URL=http://api.openweathermap.org/data/2.5/weather
OPENWEATHER_APIKEY=your API key
OPENWEATHER_LOCATIONID=location id
WEATHER_CACHE_SECONDS=600

# --- Electricity Maps (grid carbon intensity) ---
ELECTRICITYMAPS_URL=https://api.electricitymap.org/v3/carbon-intensity/latest?zone=DE
ELECTRICITYMAPS_APIKEY=your API key
ELECTRICITYMAPS_CACHE_SECONDS=900

# --- AlphaESS (solar + battery) ---
ALPHAESS_URL=https://openapi.alphaess.com/api/getLastPowerData
ALPHAESS_APPID=your app id
ALPHAESS_APPSECRET=your app secret
ALPHAESS_SYSTEMSN=your system serial number
ALPHAESS_CACHE_SECONDS=300

# --- Tibber (electricity price) ---
TIBBER_URL=https://api.tibber.com/v1-beta/gql
TIBBER_KEY=your Tibber API key
TIBBER_CACHE_SECONDS=900

# --- Fuel price (Tankerkoenig) ---
TANKEN_URL=https://creativecommons.tankerkoenig.de/json/prices.php
TANKEN_APIKEY=your API key
TANKEN_LOCATION=station id
TANKEN_CACHE_SECONDS=900

# --- News (RSS feed) ---
NEWS_RSS_FEED=URL of an RSS feed
NEWS_CACHE_SECONDS=600

# --- Mastodon home timeline ---
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=your access token
MASTODON_CACHE_TTL_SECONDS=300

# --- Google Calendar ---
GOOGLE_CREDENTIALSBASE64=base64-encoded Google service account credentials JSON
GOOGLECALENDAR_ID=calendar id (usually an email address)
GOOGLECALENDAR_URL=https://www.googleapis.com/auth/calendar.readonly
GOOGLECALENDAR_CACHE_SECONDS=900

# n8n has no env vars of its own — it POSTs markdown to /api/n8n directly.
